# Copy to .env for local development. Never commit real values.
ODIN_LOG_LEVEL=info
ODIN_DATA_DIR=.odin

# Provider credentials are intentionally blank. Local/preview provider credentials
# stay separate from public production capacity.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
NV_API_KEY=
NV_API_KEY_2=
NV_API_KEY_3=
NV_API_KEY_4=
NV_API_KEY_5=

# Public production NVIDIA capacity is fail-closed. All configured production keys
# form one shared failover/load pool; models are not pinned to individual keys.
NVIDIA_PRODUCTION_API_KEY=
NVIDIA_PRODUCTION_API_KEY_2=
NVIDIA_PRODUCTION_API_KEY_3=
NVIDIA_PRODUCTION_API_KEY_4=
NVIDIA_PRODUCTION_API_KEY_5=
ODIN_NVIDIA_PRODUCTION_AUTHORIZED=false

# Shared-compute quotas are server-side and configuration driven. Defaults are used
# when an override is omitted; values are Odin Compute Units (OCU), not messages.
ODIN_QUOTA_FREE_MONTHLY_OCU=
ODIN_QUOTA_FREE_DAILY_OCU=
ODIN_QUOTA_FREE_MAX_CONCURRENT_MISSIONS=
ODIN_QUOTA_PRO_MONTHLY_OCU=
ODIN_QUOTA_PRO_DAILY_OCU=
ODIN_QUOTA_PRO_MAX_CONCURRENT_MISSIONS=
ODIN_QUOTA_DEVELOPER_MONTHLY_OCU=
ODIN_QUOTA_DEVELOPER_DAILY_OCU=
ODIN_QUOTA_DEVELOPER_MAX_CONCURRENT_MISSIONS=
ODIN_QUOTA_ULTRA_MONTHLY_OCU=
ODIN_QUOTA_ULTRA_DAILY_OCU=
ODIN_QUOTA_ULTRA_MAX_CONCURRENT_MISSIONS=

# Product integrations. Generate ODIN_CREDENTIAL_ENCRYPTION_KEY as 32 random bytes encoded base64url.
ODIN_CREDENTIAL_ENCRYPTION_KEY=
ODIN_PUBLIC_ORIGIN=
NEON_AUTH_BASE_URL=
ODIN_DATABASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Exact Odin Price IDs. Runtime rejects substituted or unrelated Stripe prices.
STRIPE_PRO_PRICE_ID=price_1UDr55EmDA2oLCpoQJNERPTA
STRIPE_DEVELOPER_PRICE_ID=price_1UDr5HEmDA2oLCpoTuUlXUH0
STRIPE_ULTRA_PRICE_ID=price_1UDr5REmDA2oLCpoiETsQLQf
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
