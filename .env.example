# Copy to .env for local development. Never commit real values.
ODIN_LOG_LEVEL=info
ODIN_DATA_DIR=.odin

# Provider credentials are intentionally blank. The production runtime will
# obtain credentials through a secret broker instead of placing raw values in
# model context or child-worker environments.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
# Dedicated server-side credential for the Pro preview model. Never expose it to clients.
NV_API_KEY_2=

# Product integrations. Generate ODIN_CREDENTIAL_ENCRYPTION_KEY as 32 random bytes encoded base64url.
ODIN_CREDENTIAL_ENCRYPTION_KEY=
ODIN_PUBLIC_ORIGIN=
NEON_AUTH_BASE_URL=
ODIN_DATABASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Odin supports only GitHub's official hosted read-only MCP endpoint in production.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Operator-created monthly Price IDs. Paid checkout fails closed while its selected value is absent.
STRIPE_PRO_PRICE_ID=
STRIPE_DEVELOPER_PRICE_ID=
STRIPE_ULTRA_PRICE_ID=
