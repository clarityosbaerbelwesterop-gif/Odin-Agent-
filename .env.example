# Copy to .env for local development. Never commit real values.
ODIN_LOG_LEVEL=info
ODIN_DATA_DIR=.odin

# Provider credentials are intentionally blank. Local/preview provider credentials
# stay separate from public production capacity.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
NV_API_KEY=
NV_API_KEY_2=

# Public production NVIDIA capacity is fail-closed. Set the authorization flag to
# true only when the corresponding credential is explicitly approved for the
# intended public production use. Developer/API Catalog credentials are not
# silently promoted into these slots.
NVIDIA_PRODUCTION_API_KEY=
NVIDIA_PRODUCTION_API_KEY_2=
ODIN_NVIDIA_PRODUCTION_AUTHORIZED=false

# Product integrations. Generate ODIN_CREDENTIAL_ENCRYPTION_KEY as 32 random bytes encoded base64url.
ODIN_CREDENTIAL_ENCRYPTION_KEY=
ODIN_PUBLIC_ORIGIN=
NEON_AUTH_BASE_URL=
ODIN_DATABASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Exact Odin Price IDs. Runtime rejects substituted or unrelated Stripe prices.
STRIPE_PRO_PRICE_ID=price_1UDr55EmDA2oLCpoQJNERPTA
STRIPE_DEVELOPER_PRICE_ID=price_1UDr5HEmDA2oLCpoTuUlXUH0
STRIPE_ULTRA_PRICE_ID=price_1UDr5REmDA2oLCpoiETsQLQf
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
