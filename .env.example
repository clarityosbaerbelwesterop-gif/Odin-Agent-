# Copy to .env for local development. Never commit real values.
ODIN_LOG_LEVEL=info
ODIN_DATA_DIR=.odin

# Provider credentials are intentionally blank. The production runtime will
# obtain credentials through a secret broker instead of placing raw values in
# model context or child-worker environments.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
